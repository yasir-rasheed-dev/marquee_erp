{
  "name": "marquee-erp-server",
  "version": "1.0.0",
  "description": "MarqueeERP Backend - Node.js + Express + PostgreSQL + Prisma",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node src/db/seeders/seed.js",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "googleapis": "^176.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.34.0",
    "morgan": "^1.10.0",
    "prisma": "^5.17.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
