// ═══════════════════════════════════════════════════════════
//  Bank Account + Transaction Ledger
// ═══════════════════════════════════════════════════════════

// ── Enums ──
enum AccountType {
  BANK
  CASH
  CREDIT
  JAZZCASH
  EASYPAISA
  OTHER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  CREDIT   // Paisa aaya (In)
  DEBIT    // Paisa gaya (Out)
}

enum TransactionCategory {
  BOOKING_PAYMENT
  BOOKING_REFUND
  EXPENSE
  SALARY
  VENDOR_PAYMENT
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  OPENING_BALANCE
  OTHER
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  CHEQUE
  JAZZCASH
  EASYPAISA
  CREDIT_CARD
  DEBIT_CARD
  ONLINE
  OTHER
}

// ── Bank Account Master ──
model BankAccount {
  id              Int      @id @default(autoincrement())
  bankName        String
  accountHolder   String?
  accountType     AccountType   @default(BANK)
  accountNumber   String   @unique
  initialBalance  Decimal  @default(0) @db.Decimal(15, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(15, 2)
  status          AccountStatus @default(ACTIVE)
  notes           String?  @db.Text

  // Multi-tenant
  branchId        Int
  companyId       Int
  branch          Branch   @relation(fields: [branchId], references: [id])
  company         Company  @relation(fields: [companyId], references: [id])

  // Relations
  transactions    AccountTransaction[]
  dailySnapshots  DailyBalanceSnapshot[]
  payments        Payment[]              // <-- ADD
    staffPayments         StaffPayment[]
  transfersFrom AccountTransfer[] @relation("FromAccount")
  transfersTo   AccountTransfer[] @relation("ToAccount")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       Int?

  @@index([branchId, companyId])
  @@index([status])
  @@index([bankName])
}

// ── Account Transaction (Complete Ledger) ──
model AccountTransaction {
  id                 Int          @id @default(autoincrement())

  // Link to account
  bankAccountId      Int
  bankAccount        BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  // Transaction details
  type               TransactionType         // CREDIT = In, DEBIT = Out
  amount             Decimal      @db.Decimal(15, 2)
  balanceAfter       Decimal      @db.Decimal(15, 2)   // Snapshot after this tx

  // Categorization
  category           TransactionCategory
  description        String       @db.Text
  referenceNumber    String?                       // Cheque #, Txn ID, etc.

  // Link to other modules (polymorphic)
  relatedEntityType  String?                       // "Booking", "Expense", "Vendor", "Salary"
  relatedEntityId    Int?                          // ID of related record

  // Payment meta
  paymentMode        PaymentMode              @default(CASH)
  transactionDate    DateTime                 @default(now())

  // Parties involved
  paidTo             String?                       // Vendor name, Employee name, etc.
  paidFrom           String?                       // Payer name

  // Multi-tenant + Audit
  branchId           Int
  companyId          Int
  branch             Branch       @relation(fields: [branchId], references: [id])
  company            Company      @relation(fields: [companyId], references: [id])
  createdBy          Int                           // User ID
  createdByUser      User         @relation(fields: [createdBy], references: [id])

  // Attachments (optional JSON array of file URLs)
  attachments        String?      @db.Text         // JSON: [{name, url, size}]

  // Reconciliation
  isReconciled       Boolean      @default(false)
  reconciledAt       DateTime?
  reconciledBy       Int?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([bankAccountId, transactionDate])
  @@index([bankAccountId, type])
  @@index([bankAccountId, category])
  @@index([relatedEntityType, relatedEntityId])
  @@index([branchId, companyId, transactionDate])
  @@index([transactionDate])
}

// ── Daily Balance Snapshot (Performance + Opening Balance) ──
model DailyBalanceSnapshot {
  id                Int      @id @default(autoincrement())

  bankAccountId     Int
  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  date              DateTime @db.Date

  openingBalance    Decimal  @db.Decimal(15, 2)   // Subah ka balance
  closingBalance    Decimal  @db.Decimal(15, 2)   // Raat ka balance

  totalCredits      Decimal  @default(0) @db.Decimal(15, 2)
  totalDebits       Decimal  @default(0) @db.Decimal(15, 2)
  transactionCount  Int      @default(0)

  branchId          Int
  companyId         Int

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([bankAccountId, date])
  @@index([bankAccountId, date])
  @@index([branchId, companyId, date])
}

// ── Account Transfer (A/C to A/C) ──
model AccountTransfer {
  id                Int      @id @default(autoincrement())

  fromAccountId     Int
  toAccountId       Int
  fromAccount       BankAccount @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount         BankAccount @relation("ToAccount", fields: [toAccountId], references: [id])

  amount            Decimal  @db.Decimal(15, 2)
  transferDate      DateTime @default(now())
  description       String?
  referenceNumber   String?

  // Auto-created transaction IDs
  debitTransactionId  Int?
  creditTransactionId Int?

  branchId          Int
  companyId         Int
  createdBy         Int

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fromAccountId, transferDate])
  @@index([toAccountId, transferDate])
}
model AccountCustomCategory {
  id          Int          @id @default(autoincrement())
  name        String       
  type        TransactionType
  branchId    Int
  companyId   Int
  branch      Branch       @relation(fields: [branchId], references: [id])
  company     Company      @relation(fields: [companyId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, branchId])
}

