  totalBasicSalary Decimal       @default(0) @db.Decimal(12, 2)
  totalAllowances  Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions  Decimal       @default(0) @db.Decimal(12, 2)
  totalBonuses     Decimal       @default(0) @db.Decimal(12, 2)
  totalOvertime    Decimal       @default(0) @db.Decimal(12, 2)
  totalNetSalary   Decimal       @default(0) @db.Decimal(12, 2)
  status           PayrollStatus @default(draft)
  notes            String?
  companyId        Int
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId         Int?
  branch           Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  processedById    Int?
  processedAt      DateTime?
  paidAt           DateTime?
  items            PayrollItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([payrollNo, companyId])
  @@index([companyId])
  @@index([branchId])
  @@index([month, year])
  @@index([status])
  @@map("payrolls")
}

model PayrollItem {
  id                Int      @id @default(autoincrement())
  payrollId         Int
  payroll           Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId        Int
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // ── Working Days ──
  totalDays         Int      @default(30)
  presentDays       Int      @default(0)
  absentDays        Int      @default(0)
  leaveDays         Int      @default(0)
  overtimeHours     Decimal  @default(0) @db.Decimal(5, 2)

  // ── Earnings ──
  basicSalary       Decimal  @default(0) @db.Decimal(12, 2)
  houseRent         Decimal  @default(0) @db.Decimal(12, 2)
  medicalAllowance  Decimal  @default(0) @db.Decimal(12, 2)
  conveyance        Decimal  @default(0) @db.Decimal(12, 2)
  bonus             Decimal  @default(0) @db.Decimal(12, 2)
  overtimeAmount    Decimal  @default(0) @db.Decimal(12, 2)
  eventPayments     Decimal  @default(0) @db.Decimal(12, 2) // Events in this period

  // ── Deductions ──
  loanDeduction     Decimal  @default(0) @db.Decimal(12, 2)
  advanceDeduction  Decimal  @default(0) @db.Decimal(12, 2)
  taxDeduction      Decimal  @default(0) @db.Decimal(12, 2)
  otherDeductions   Decimal  @default(0) @db.Decimal(12, 2)
  absentDeduction   Decimal  @default(0) @db.Decimal(12, 2)

  // ── Totals ──
  grossSalary       Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions   Decimal  @default(0) @db.Decimal(12, 2)
  netSalary         Decimal  @default(0) @db.Decimal(12, 2)

  // ── Payment ──
  paidAmount        Decimal  @default(0) @db.Decimal(12, 2)
  dueAmount         Decimal  @default(0) @db.Decimal(12, 2)
  paymentStatus     String   @default("pending") @db.VarChar(20)
  bankAccountId     Int?
  paymentDate       DateTime?
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([payrollId, employeeId])
  @@index([payrollId])
  @@index([employeeId])
  @@map("payroll_items")
}

