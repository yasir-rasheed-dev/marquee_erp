  category       String         @db.VarChar(100)
  condition      AssetCondition @default(GOOD)
  quantity       Int            @default(1)
  costPrice      Decimal        @default(0) @db.Decimal(12, 2)
  totalValuation Decimal        @default(0) @db.Decimal(12, 2)
