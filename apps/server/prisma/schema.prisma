// ── EMPLOYEE / STAFF MASTER ──
model Employee {
  id              Int            @id @default(autoincrement())
  employeeCode    String         @db.VarChar(50)

  // ── Personal Info ──
  name            String         @db.VarChar(200)
  fatherName      String?        @db.VarChar(200)
  phone           String         @db.VarChar(20)
  email           String?        @db.VarChar(100)
  cnic            String?        @db.VarChar(20)
  dateOfBirth     DateTime?
  gender          String?        @db.VarChar(10)
  maritalStatus   String?        @db.VarChar(20)
  address         String?
  city            String?        @db.VarChar(100)
  emergencyContact String?       @db.VarChar(20)
  emergencyName   String?        @db.VarChar(200)
 notes           String? 
  // ── Job Info ──
  designationId   Int
  designation     Designation    @relation(fields: [designationId], references: [id], onDelete: Cascade)
  departmentId    Int?
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  joinDate        DateTime       @default(now())
  resignDate      DateTime?

  // ── Salary Config ──
  salaryType      SalaryType     @default(fixed_monthly)
  basicSalary     Decimal        @default(0) @db.Decimal(12, 2)
  perEventRate    Decimal?       @db.Decimal(12, 2)    // Per event rate
  hourlyRate      Decimal?       @db.Decimal(12, 2)    // Hourly rate
  dailyRate       Decimal?       @db.Decimal(12, 2)    // Daily rate

  // ── Financial Tracking ──
  openingBalance  Decimal        @default(0) @db.Decimal(12, 2)
  currentBalance  Decimal        @default(0) @db.Decimal(12, 2) // + company owes, - advance taken
  totalEarned     Decimal        @default(0) @db.Decimal(12, 2)
  totalPaid       Decimal        @default(0) @db.Decimal(12, 2)
  totalLoan       Decimal        @default(0) @db.Decimal(12, 2)
  totalLoanPaid   Decimal        @default(0) @db.Decimal(12, 2)
  totalAdvance    Decimal        @default(0) @db.Decimal(12, 2)

  // ── Status ──
  status          EmployeeStatus @default(active)
  isActive        Boolean        @default(true)
  deletedAt       DateTime?

  // ── Auth Link (Optional) ──
  userId          Int?          @unique   // <-- @unique ADD karo
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ── Multi-tenant ──
  companyId       Int
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        Int?
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // ── Relations ──
  attendances         Attendance[]
  leaves              Leave[]
  leaveBalances       EmployeeLeaveBalance[]
  loans               EmployeeLoan[]
  payrolls            PayrollItem[]
  eventAssignments    EventStaffAssignment[]
  ledgers             StaffLedger[]
  bankDetails         EmployeeBankDetail[]
  documents           EmployeeDocument[]
  salaryHistory       EmployeeSalaryHistory[]
    staffPayments         StaffPayment[]    // <-- ADD karo

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeCode, companyId])
  @@unique([cnic, companyId])
  @@index([companyId])
  @@index([branchId])
  @@index([designationId])
  @@index([departmentId])
  @@index([status])
  @@index([phone])
  @@index([userId])
  @@index([deletedAt])
  @@map("employees")
}

// ── EMPLOYEE DOCUMENTS ──
model EmployeeDocument {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
