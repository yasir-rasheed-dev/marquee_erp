// ═══════════════════════════════════════════════════════════
// ITEM MASTER
// ═══════════════════════════════════════════════════════════

model Item {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  code        String?  @db.VarChar(50)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  description String?
  unit        String   @default("plate") @db.VarChar(20)
  unitId      Int?
  unitRef     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  
  // ✅ Bulk Conversion Support (e.g. 1 Degh = 50 Plates)
  isBulkUnit     Boolean  @default(false)
  conversionRate Decimal  @default(1) @db.Decimal(10, 2) // e.g., 50 plates in 1 degh
  subUnitName    String?  @default("plate") @db.VarChar(20) // e.g., plate

  costPrice   Decimal  @default(0) @db.Decimal(10, 2)
  salePrice   Decimal  @default(0) @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  menuItems           MenuItem[]
  posTransactionItems POSTransactionItem[]
  recipeIngredients  RecipeIngredient[]

  createdById Int?
  createdBy   User?    @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?    @relation("ItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, companyId])
  @@index([categoryId])
  @@index([branchId])
  @@index([companyId])
  @@index([unitId])
  @@index([deletedAt])
  @@map("items")
}

// ═══════════════════════════════════════════════════════════
// MENU SYSTEM
// ═══════════════════════════════════════════════════════════

model Menu {
  id          Int          @id @default(autoincrement())
  name        String
  code        String?      @db.VarChar(50)
  description String?
  eventType   String?      @db.VarChar(50)
  packageType String       @default("per_head") @db.VarChar(20)
  status      MenuStatus   @default(active)

  guestCount  Int          @default(100) // ✅ Added: Total guests for this menu

  totalCostPrice Decimal @default(0) @db.Decimal(12, 2)
  totalSalePrice Decimal @default(0) @db.Decimal(12, 2)
  profitMargin   Decimal @default(0) @db.Decimal(5, 2)

  isSessional Boolean    @default(false)
  startDate   DateTime?
  endDate     DateTime?
  deletedAt   DateTime?

  companyId   Int
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  categories  MenuCategory[]
  items       MenuItem[]
  packageMenus       PackageMenu[]
  bookingMenus       BookingMenu[]
  menuChangeLogs     BookingMenuChangeLog[]

  createdById Int?
  createdBy   User?        @relation("MenuCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?        @relation("MenuUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([code, companyId])
  @@index([branchId])
  @@index([companyId])
  @@index([status])
  @@map("menus")
}

model MenuCategory {
  id        Int      @id @default(autoincrement())
  name      String
  sortOrder Int      @default(0)

  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
  @@map("menu_categories")
}

model MenuItem {
  id              Int          @id @default(autoincrement())
  menuId          Int
  menu            Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  categoryId      Int
  category        MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemId          Int?
  item            Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)

  name            String
  code            String?      @db.VarChar(50)
  description     String?
  unit            String       @default("Degh") @db.VarChar(20)
  costPrice       Decimal      @default(0) @db.Decimal(10, 2)
  salePrice       Decimal      @default(0) @db.Decimal(10, 2)
  quantityPerHead Decimal      @default(1) @db.Decimal(10, 2) // Qty or calculated Degh qty

  isBulkUnit      Boolean      @default(true)
  conversionRate  Decimal      @default(50) @db.Decimal(10, 2) // e.g., 50 plates in 1 Degh
  subUnitName     String       @default("plate") @db.VarChar(20)
  eventDishUsages    EventDishUsage[]
  productionPlanItems ProductionPlanItem[]
  kitchenOrderItems  KitchenOrderItem[]
 bookingMenuItems    BookingMenuItem[]
  isActive        Boolean      @default(true)
  branchId        Int?
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId       Int
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([menuId])
  @@index([categoryId])
  @@index([branchId])
  @@map("menu_items")
}

model RecipeIngredient {
  id              Int      @id @default(autoincrement())
  name            String
  unit            String
  unitId          Int?
  unitRef         Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  quantity        Decimal  @db.Decimal(10, 3)
  costPerUnit     Decimal  @default(0) @db.Decimal(12, 2)

  // 🔥 inventoryItemId optional (kyunki custom items ke liye null ho sakta hai)
  inventoryItemId Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  // 🔥 itemId optional rakha hai (kyunki purani rows mein data nahi hai)
  // ✅ BAD MEIN ISKO REQUIRED KAR DENGE
  itemId          Int?
  item            Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([itemId])
  @@index([inventoryItemId])
  @@index([unitId])
  @@map("recipe_ingredients")
}

// ═══════════════════════════════════════════════════════════
// RECIPE / BOM MANAGER
// ═══════════════════════════════════════════════════════════

model RecipeItem {
  id           Int           @id @default(autoincrement())
  dishId       Int
  dish         InventoryItem @relation("DishRecipe", fields: [dishId], references: [id], onDelete: Cascade)

  ingredientId Int
  ingredient   InventoryItem @relation("IngredientItem", fields: [ingredientId], references: [id], onDelete: Cascade)

  quantity     Decimal       @db.Decimal(12, 3)
  unit         String        @db.VarChar(20)
  unitId       Int?
  unitRef      Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)

  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId     Int?
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([dishId, ingredientId])
  @@index([dishId])
  @@index([ingredientId])
  @@index([companyId])
  @@index([branchId])
  @@index([unitId])
  @@map("recipe_items")
}

// ═══════════════════════════════════════════════════════════
// INVENTORY
// ═══════════════════════════════════════════════════════════

model InventoryItem {
  id            Int      @id @default(autoincrement())
  name          String
  code          String?  @db.VarChar(50)
  category      String   @db.VarChar(100)
  subCategory   String?  @db.VarChar(100)
  unit          String   @db.VarChar(20)
  unitId        Int?
  unitRef       Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  currentStock  Decimal  @default(0) @db.Decimal(12, 3)
  minStock      Decimal  @default(0) @db.Decimal(12, 3)
  maxStock      Decimal  @default(0) @db.Decimal(12, 3)

  avgCostPrice  Decimal  @default(0) @db.Decimal(12, 2)
  lastCostPrice Decimal  @default(0) @db.Decimal(12, 2)
  salePrice     Decimal  @default(0) @db.Decimal(12, 2)

  isBoxEnabled  Boolean  @default(false)
  unitsPerBox   Int      @default(1)

  manageStock   Boolean  @default(true)
  isPosVisible  Boolean  @default(true)

  isActive      Boolean  @default(true)
  deletedAt     DateTime?

  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      Int?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  transactions        StockTransaction[]
  transfersFrom       StockTransfer[] @relation("TransferFromBranch")

  recipesAsDish       RecipeItem[] @relation("DishRecipe")
  recipesAsIngredient RecipeItem[] @relation("IngredientItem")
  recipeIngredients   RecipeIngredient[]
  wastageLogs         WastageLog[]
  productionPlanItems ProductionPlanItem[]
  kitchenOrderItems   KitchenOrderItem[]
  eventInventoryConsumptions EventInventoryConsumption[]
  eventDamages        EventDamage[]
  poItems           POItem[]
  purchaseItems     PurchaseItem[]
  purchaseBillItems PurchaseBillItem[]   // <-- ADD
  returnItems       PurchaseReturnItem[]

  createdById   Int?
  createdBy     User?    @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById   Int?
  updatedBy     User?    @relation("InventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([code, companyId])
  @@index([branchId])
  @@index([companyId])
  @@index([unitId])
  @@index([deletedAt])
  @@map("inventory_items")
}

model StockTransaction {
  id            Int                @id @default(autoincrement())
  inventoryId   Int
  inventory     InventoryItem      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type          StockTransactionType
  quantity      Decimal            @db.Decimal(12, 3)
  costPrice     Decimal            @db.Decimal(12, 2)
  notes         String?

  referenceType String?            @db.VarChar(50)
  referenceId   Int?
  bookingId     Int?
  booking       Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  userId        Int
  user          User               @relation("StockTransactionUser", fields: [userId], references: [id], onDelete: Cascade)

  branchId      Int?
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId     Int

  createdAt     DateTime           @default(now())

  @@index([inventoryId])
  @@index([userId])
  @@index([createdAt])
  @@index([branchId])
  @@index([companyId])
  @@index([bookingId])
  @@index([referenceType])
  @@map("stock_transactions")
}

model StockTransfer {
  id            Int           @id @default(autoincrement())
  inventoryId   Int
  inventory     InventoryItem @relation("TransferFromBranch", fields: [inventoryId], references: [id], onDelete: Cascade)

  fromBranchId  Int
  fromBranch    Branch        @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranchId    Int
  toBranch      Branch        @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Cascade)

  quantity      Decimal       @db.Decimal(12, 3)
  notes         String?
  status        String        @default("COMPLETED") @db.VarChar(20)

  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById   Int
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([inventoryId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([companyId])
  @@index([createdById])
  @@map("stock_transfers")
}

// ═══════════════════════════════════════════════════════════
// PACKAGE MASTER
// ═══════════════════════════════════════════════════════════

model Package {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(200)
  code        String?       @db.VarChar(50)
  eventType   String?       @db.VarChar(50)
  status      PackageStatus @default(active)
  description String?

  basePrice   Decimal       @default(0) @db.Decimal(12, 2)
  discountPct Decimal       @default(0) @db.Decimal(5, 2)
  finalPrice  Decimal       @default(0) @db.Decimal(12, 2)

  isActive    Boolean       @default(true)
  deletedAt   DateTime?

  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  menus       PackageMenu[]
  extras      PackageExtra[]
   services    PackageService[] 

  createdById Int?
  createdBy   User?         @relation("PackageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?         @relation("PackageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([code, companyId])
  @@index([status])
  @@index([branchId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("packages")
}

model PackageMenu {
  id        Int      @id @default(autoincrement())
  packageId Int
  menuId    Int
  quantity  Int      @default(1)

  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([packageId, menuId])
  @@index([packageId])
  @@index([menuId])
  @@map("package_menus")
}

model PackageExtra {
  id          Int      @id @default(autoincrement())
  packageId   Int
  name        String   @db.VarChar(200)
  description String?
  costPrice   Decimal  @default(0) @db.Decimal(10, 2)
  salePrice   Decimal  @default(0) @db.Decimal(10, 2)

  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_extras")
}
model PackageService {
  id          Int      @id @default(autoincrement())
  packageId   Int
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  
  serviceId   Int?     // null = custom service
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  
  name        String   @db.VarChar(200)
  description String?
  pricingType String   @default("FIXED") @db.VarChar(20)  // FIXED | HOURLY
  costPrice   Decimal  @default(0) @db.Decimal(10, 2)
  salePrice   Decimal  @default(0) @db.Decimal(10, 2)
  quantity    Int      @default(1)
  hours       Int?     // sirf HOURLY ke liye

  @@index([packageId])
  @@map("package_services")
}

// ═══════════════════════════════════════════════════════════
// EVENT TYPES
// ═══════════════════════════════════════════════════════════

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  code        String?  @db.VarChar(50)
  description String?
  color       String?  @db.VarChar(20)
  icon        String?  @db.VarChar(50)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  bookings    Booking[]

  createdById Int?
  createdBy   User?    @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?    @relation("EventUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, companyId])
  @@index([branchId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("events")
}

// ═══════════════════════════════════════════════════════════
// HALLS & VENUES
// ═══════════════════════════════════════════════════════════

model Hall {
  id          Int      @id @default(autoincrement())
  name        String
  code        String?  @db.VarChar(50)
  description String?
  capacity    Int      @default(0)
  price       Decimal  @default(0) @db.Decimal(12, 2)
  perSeatPrice Decimal? @db.Decimal(12, 2)
  pricingType String   @default("fixed") // fixed | per_seat | both
  isActive    Boolean  @default(true)
  deletedAt   DateTime?

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  bookings          Booking[]
  sessions          HallSession[]
  hallBookingSlots  HallBookingSlot[]

  createdById Int?
  createdBy   User?    @relation("HallCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedBy   User?    @relation("HallUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([code, companyId])
  @@index([branchId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("halls")
}

model HallSession {
  id        Int      @id @default(autoincrement())
  name      String
  startTime String   @db.VarChar(10)
  endTime   String   @db.VarChar(10)
  duration  Int
  isActive  Boolean  @default(true)
  deletedAt DateTime?

  hallId    Int
  hall      Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hallId])
  @@map("hall_sessions")
}

// ═══════════════════════════════════════════════════════════
// BOOKING SYSTEM (ENHANCED)
// ═══════════════════════════════════════════════════════════

model Booking {
  id              Int           @id @default(autoincrement())
  bookingNo       String        @db.VarChar(50)
  title           String
  description     String?

  eventId         Int?
  event           Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventType       String        @db.VarChar(50)

  eventDate       DateTime
  startTime       DateTime
  endTime         DateTime

  guestCount      Int           @default(0)
  actualGuestCount Int?

  guestName       String
  guestPhone      String
  guestEmail      String?


  customerId      Int?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  isMealIncluded  Boolean       @default(true)

  status          BookingStatus @default(tentative)
  paymentStatus   PaymentStatus @default(pending)

  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  advanceAmount   Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
   taxRateId       Int?
  taxRate         Decimal?      @db.Decimal(5, 2)
  taxAmount       Decimal?      @db.Decimal(12, 2)
   package_total   Decimal?      @default(0) @db.Decimal(15, 2)
  selected_package Json?        // Package ka complete data store karne ke liye
  // ── END FIX ──
  

  hallChargeMode  String?       @default("per_seat") // per_seat | full_hall

  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        Int?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  hallId          Int?
  hall            Hall?         @relation(fields: [hallId], references: [id], onDelete: SetNull)

  createdById     Int
  createdBy       User          @relation("BookingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo      Int?
  assignee        User?         @relation("BookingAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  updatedById     Int?
  updatedBy       User?         @relation("BookingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)


bookingMenuItems BookingMenuItem[]
  menus           BookingMenu[]
  invoices        Invoice[]
  tasks           Task[]
  payments        Payment[]
  whatsappMessages WhatsAppMessage[]
  emailLogs       EmailLog[]

  stockTransactions StockTransaction[]
  wastageLogs       WastageLog[]
  productionPlans   ProductionPlan[]
  kitchenOrders     KitchenOrder[]

  services          BookingService[]
  hallBookingSlots  HallBookingSlot[]
  changeLogs        BookingChangeLog[]
  menuChangeLogs    BookingMenuChangeLog[]
  serviceChangeLogs BookingServiceChangeLog[]
  eventExecution    EventExecution?
  eventDishUsages   EventDishUsage[]
  eventInventoryConsumptions EventInventoryConsumption[]
  eventDamages      EventDamage[]
  customItems BookingCustomItem[]
    eventStaffAssignments EventStaffAssignment[]

  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([bookingNo, companyId])
  @@index([eventDate])
  @@index([status])
  @@index([branchId])
  @@index([companyId])
  @@index([eventId])
  @@index([customerId])
  @@index([deletedAt])
  @@map("bookings")
}
model BookingCustomItem {
  id        Int     @id @default(autoincrement())
  bookingId Int
  itemId    Int
  itemName  String
  quantity  Int
  unitPrice Float
  totalPrice Float
  unit      String?
  notes     String?
  booking   Booking @relation(fields: [bookingId], references: [id])
  
  @@index([bookingId])
}
model BookingMenuItem {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  menuItemId  Int
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  quantity    Decimal  @db.Decimal(12, 3)  // Kitni degh/plate
  unit        String   @db.VarChar(20)
  unitId      Int?
  unitRef     Unit?    @relation(fields: [unitId], references: [id])
  
  isDeducted  Boolean  @default(false)     // <-- Track karne ke liye
  deductedAt  DateTime?
  
  @@index([bookingId])
  @@map("booking_menu_items")
}

model BookingMenu {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  menuId     Int
   menuName    String?
  quantity   Int      @default(1)
  unit       String?  @db.VarChar(20)
  unitId     Int?
  unitRef    Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitPrice  Decimal  @db.Decimal(12, 2)
  totalPrice Decimal  @db.Decimal(12, 2)
  notes      String?

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([bookingId, menuId])
  @@index([bookingId])
  @@index([unitId])
  @@map("booking_menus")
}

model BookingService {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   Int
  serviceName String?
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
  @@map("booking_services")
}

// ═══════════════════════════════════════════════════════════
// HALL BOOKING SLOTS (Capacity Management)
// ═══════════════════════════════════════════════════════════

model HallBookingSlot {
  id          Int      @id @default(autoincrement())
  hallId      Int
  hall        Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  bookingId   Int
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  slotDate    DateTime
  startTime   DateTime
  endTime     DateTime
  guestCount  Int      @default(0)

  createdAt   DateTime @default(now())

  @@index([hallId, slotDate])
  @@index([bookingId])
  @@map("hall_booking_slots")
}

// ═══════════════════════════════════════════════════════════
// BOOKING CHANGE LOGS (Dynamic History)
// ═══════════════════════════════════════════════════════════

model BookingChangeLog {
  id          Int        @id @default(autoincrement())
  bookingId   Int
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fieldName   String     @db.VarChar(50)
  changeType  ChangeType @default(other)
  oldValue    String?
  newValue    String?
  notes       String?

  changedById Int
  changedBy   User       @relation(fields: [changedById], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())

  @@index([bookingId])
  @@index([changedById])
  @@index([createdAt])
  @@map("booking_change_logs")
}

model BookingMenuChangeLog {
  id          Int        @id @default(autoincrement())
  bookingId   Int
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  menuId      Int
  menu        Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)

  changeType  ChangeType @default(other)
  oldQuantity Int?
  newQuantity Int?
  oldPrice    Decimal?   @db.Decimal(12, 2)
  newPrice    Decimal?   @db.Decimal(12, 2)
  notes       String?

  changedById Int
  changedBy   User       @relation(fields: [changedById], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())

  @@index([bookingId])
  @@index([menuId])
  @@index([changedById])
  @@map("booking_menu_change_logs")
}

model BookingServiceChangeLog {
  id          Int        @id @default(autoincrement())
  bookingId   Int
  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  serviceId   Int
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  changeType  ChangeType @default(other)
  oldQuantity Int?
  newQuantity Int?
  oldPrice    Decimal?   @db.Decimal(12, 2)
  newPrice    Decimal?   @db.Decimal(12, 2)
  notes       String?

  changedById Int
  changedBy   User       @relation(fields: [changedById], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())

  @@index([bookingId])
  @@index([serviceId])
  @@index([changedById])
  @@map("booking_service_change_logs")
}

// ═══════════════════════════════════════════════════════════
// EVENT EXECUTION & COST TRACKING
// ═══════════════════════════════════════════════════════════

model EventExecution {
  id                  Int                   @id @default(autoincrement())
  bookingId           Int                   @unique
  booking             Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status              EventExecutionStatus  @default(planned)

  plannedGuestCount   Int                   @default(0)
  actualGuestCount    Int                   @default(0)
  extraGuestCount     Int                   @default(0)

  hallCost            Decimal               @default(0) @db.Decimal(12, 2)
  menuCost            Decimal               @default(0) @db.Decimal(12, 2)
  serviceCost         Decimal               @default(0) @db.Decimal(12, 2)
  inventoryCost       Decimal               @default(0) @db.Decimal(12, 2)
  wastageCost         Decimal               @default(0) @db.Decimal(12, 2)
  damageCost          Decimal               @default(0) @db.Decimal(12, 2)
  otherCosts          Decimal               @default(0) @db.Decimal(12, 2)
  totalCost           Decimal               @default(0) @db.Decimal(12, 2)

  totalRevenue        Decimal               @default(0) @db.Decimal(12, 2)
  totalDiscount       Decimal               @default(0) @db.Decimal(12, 2)
  netRevenue          Decimal               @default(0) @db.Decimal(12, 2)
  profit              Decimal               @default(0) @db.Decimal(12, 2)
  profitMargin        Decimal               @default(0) @db.Decimal(5, 2)
    inventoryDeducted     Boolean  @default(false)
  inventoryDeductedAt   DateTime?

  notes               String?

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([bookingId])
  @@index([status])
  @@map("event_executions")
}

model EventDishUsage {
  id              Int       @id @default(autoincrement())
  bookingId       Int
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  menuItemId      Int?
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  dishName        String    @db.VarChar(200)

  plannedQuantity Decimal   @default(0) @db.Decimal(12, 3)
  actualQuantity  Decimal   @default(0) @db.Decimal(12, 3)
  unit            String    @db.VarChar(20)
  unitId          Int?
  unitRef         Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  costPerUnit     Decimal   @default(0) @db.Decimal(12, 2)
  totalCost       Decimal   @default(0) @db.Decimal(12, 2)

  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bookingId])
  @@index([menuItemId])
  @@index([unitId])
  @@map("event_dish_usage")
}

model EventInventoryConsumption {
  id              Int           @id @default(autoincrement())
  bookingId       Int
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  plannedQuantity Decimal       @default(0) @db.Decimal(12, 3)
  actualQuantity  Decimal       @default(0) @db.Decimal(12, 3)
  unit            String        @db.VarChar(20)
  unitId          Int?
  unitRef         Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)

  costPerUnit     Decimal       @default(0) @db.Decimal(12, 2)
  totalCost       Decimal       @default(0) @db.Decimal(12, 2)

  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([bookingId])
  @@index([inventoryItemId])
  @@index([unitId])
  @@map("event_inventory_consumption")
}

model EventDamage {
  id              Int            @id @default(autoincrement())
  bookingId       Int
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  inventoryItemId Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  assetId         Int?
  asset           Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)

  itemName        String         @db.VarChar(200)
  quantity        Decimal        @default(0) @db.Decimal(12, 3)
  unit            String?        @db.VarChar(20)
  unitId          Int?
  unitRef         Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)

  costPrice       Decimal        @default(0) @db.Decimal(12, 2)
  totalCost       Decimal        @default(0) @db.Decimal(12, 2)

  description     String?
  images          String?

  createdById     Int
  createdBy       User           @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([bookingId])
  @@index([inventoryItemId])
  @@index([assetId])
  @@index([createdById])
  @@map("event_damages")
}

// ═══════════════════════════════════════════════════════════
// PAYMENTS & INVOICES
// ═══════════════════════════════════════════════════════════

model Invoice {
  id          Int           @id @default(autoincrement())
  invoiceNo   String        @db.VarChar(50)
  bookingId   Int
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus @default(pending)
  dueDate     DateTime?
  notes       String?

  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  items       InvoiceItem[]
  payments    Payment[]

  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([invoiceNo, companyId])
  @@index([bookingId])
  @@index([branchId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id          Int           @id @default(autoincrement())
  paymentNo   String        @db.VarChar(50)
  invoiceId   Int?
  invoice     Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(cash)
  paymentType PaymentType   @default(final)
  reference   String?
  notes       String?
  status      PaymentStatus @default(completed)
  purchaseBillId    Int?
  purchaseBill      PurchaseBill? @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)
  purchaseId        Int?
  purchase          Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  bookingId   Int?
  booking     Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
   supplierId    Int?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])

  userId      Int
  user        User          @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)

  branchId    Int?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
bankAccountId     Int?
  bankAccount       BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([paymentNo, companyId])
  @@index([invoiceId])
  @@index([userId])
  @@index([branchId])
  @@index([companyId])
  @@index([deletedAt])
   @@index([bankAccountId])
  @@map("payments")
}

// ═══════════════════════════════════════════════════════════
// TASKS / CHECKLISTS
// ═══════════════════════════════════════════════════════════

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus   @default(pending)
  priority    TaskPriority @default(medium)

  bookingId   Int
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  assignedTo  Int?
  assignee    User?        @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  dueDate     DateTime?
  completedAt DateTime?

  branchId    Int?
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId   Int

  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([branchId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("tasks")
}

// ═══════════════════════════════════════════════════════════
// POS / CASHIER
// ═══════════════════════════════════════════════════════════

model POSSession {
  id           Int              @id @default(autoincrement())
  sessionNo    String           @db.VarChar(50)
  userId       Int
  user         User             @relation("POSSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  branchId     Int?
  branch       Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId    Int

  openingTime  DateTime         @default(now())
  closingTime  DateTime?
  openingCash  Decimal          @default(0) @db.Decimal(12, 2)
  closingCash  Decimal?         @db.Decimal(12, 2)
  expectedCash Decimal?         @db.Decimal(12, 2)
  difference   Decimal?         @db.Decimal(12, 2)

  status       POSSessionStatus @default(open)
  notes        String?

  transactions POSTransaction[]

  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([sessionNo, companyId])
  @@index([userId])
  @@index([branchId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("pos_sessions")
}

model POSTransaction {
  id            Int                  @id @default(autoincrement())
  transactionNo String               @db.VarChar(50)
  sessionId     Int
  session       POSSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type          POSTransactionType
  amount        Decimal              @db.Decimal(12, 2)
  paymentMethod PaymentMethod        @default(cash)

  customerName  String?
  customerPhone String?

  status        POSTransactionStatus @default(completed)
  notes         String?

  branchId      Int?
  branch        Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId     Int

  items         POSTransactionItem[]

  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([transactionNo, companyId])
  @@index([sessionId])
  @@index([branchId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("pos_transactions")
}

model POSTransactionItem {
