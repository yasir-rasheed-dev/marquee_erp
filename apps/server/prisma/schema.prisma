// 1. Role Master Table (Custom roles bananay ke liye)
model Role {
  id          Int       @id @default(autoincrement())
  name        String    // e.g., "Hall Manager", "Head Chef", "Custom Cashier"
  slug        String    // e.g., "hall_manager" (system unique identifier)
  description String?
  isSystem    Boolean   @default(false) // true = default roles jo delete na ho saken (Admin/Super Admin)

  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?      
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  permissions RolePermission[]
  users       UserRoleAssignment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, companyId])
  @@index([companyId])
  @@map("roles")
}

