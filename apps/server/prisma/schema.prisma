enum PermissionAction {
  view
  create
  edit
  delete
  export
  import
  print
  approve
  execute
}

// 3. Role Permissions (Ab yeh Enum ki jagah Role ID se link hoga)
model RolePermission {
  id        Int       @id @default(autoincrement())
  roleId    Int?      // Optional scalar field
  role      Role?     @relation(fields: [roleId], references: [id], onDelete: Cascade) // 👈 Yahan bhi ? lagana lazmi hai
  
  resource  PermissionResource
  action    PermissionAction
  allowed   Boolean   @default(true)

  companyId Int
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  Int?
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("role_permissions")
}

// 4. User to Role Assignment (User ko dynamic role assign karne ke liye)
model UserRoleAssignment {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  roleId      Int      // Enum ki bajaye dynamic Role ID
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, roleId, companyId, branchId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}
enum BackupStatus {
  pending
  running
  completed
  failed
  deleted
}

enum BackupLocation {
  local
  google_drive
  both
}

model BackupLog {
  id            Int             @id @default(autoincrement())
  backupNo      String          @unique @db.VarChar(50)  // BKP-20260824-001

  // File Info
  fileName      String          @db.VarChar(200)
  filePath      String?         @db.VarChar(500)        // Local path
  fileSize      Int?                                    // Bytes
  driveFileId   String?         @db.VarChar(200)        // Google Drive File ID
  driveLink     String?         @db.VarChar(500)        // Shareable link

  // Metadata
  status        BackupStatus    @default(pending)
  location      BackupLocation  @default(local)
  dbName        String          @db.VarChar(100)
  tablesCount   Int?            @default(0)

  // Retention
  isAutoDeleted Boolean         @default(false)
  deletedAt     DateTime?
  deletedReason String?         @db.VarChar(100)

  // Multi-tenant
  companyId     Int
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      Int?
  branch        Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdById   Int
  createdBy     User            @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([companyId, createdAt])
  @@index([status])
  @@index([location])
  @@map("backup_logs")
}
// ═══════════════════════════════════════════════════════════
// RECEIPT SETTINGS (Backend Storage)
// Pehle localStorage mein tha, ab database mein
// ═══════════════════════════════════════════════════════════

model ReceiptSetting {
  id        Int      @id @default(autoincrement())

  // ── Company Info ──
  companyName    String   @default("UniSoft Enterprise") @db.VarChar(200)
  companySlogan  String?  @db.VarChar(200)
  address        String?  @db.Text
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(100)
  website        String?  @db.VarChar(100)
  logoUrl        String?  @db.Text

  // ── Receipt Text ──
  headerText  String?  @db.VarChar(500)
  footerText  String?  @db.VarChar(500)
  marqueeText String?  @db.VarChar(500)

  // ── Show / Hide Toggles ──
  showLogo           Boolean @default(true)
  showCompanyName    Boolean @default(true)
  showSlogan         Boolean @default(true)
  showAddress        Boolean @default(true)
  showPhone          Boolean @default(true)
  showEmail          Boolean @default(true)
  showWebsite        Boolean @default(true)
  showHeaderText     Boolean @default(true)
  showFooterText     Boolean @default(true)
  showMarquee        Boolean @default(true)
  showQrCode         Boolean @default(false)
  showBarcode        Boolean @default(false)
  showGst            Boolean @default(false)
  showNTN            Boolean @default(false)
  showEventDetails     Boolean @default(true)
  showCustomerDetails  Boolean @default(true)
  showPaymentHistory   Boolean @default(true)

  // ── Tax & Legal ──
  gstNumber String? @db.VarChar(50)
  ntnNumber String? @db.VarChar(50)

  // ── Theme & Colors ──
  themeColor  String @default("#1a1a2e") @db.VarChar(20)
  accentColor String @default("#A97A1F") @db.VarChar(20)

  // ── Thermal Printer ──
  thermalWidth    String @default("80mm") @db.VarChar(10)
  thermalFontSize String @default("12px") @db.VarChar(10)

  // ── Soft Delete ──
  deletedAt DateTime?

  // ── Multi-tenant ──
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  Int?
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, branchId])
  @@index([companyId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("receipt_settings")
}