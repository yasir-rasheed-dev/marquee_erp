}

// ── DESIGNATION MASTER ──
model Designation {
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(100)
  code            String?    @db.VarChar(50)
  description     String?
  defaultSalary   Decimal    @default(0) @db.Decimal(12, 2)
  defaultSalaryType SalaryType @default(fixed_monthly)
