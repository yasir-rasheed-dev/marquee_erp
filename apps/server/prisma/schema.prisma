// ═══════════════════════════════════════════════════════════
// CUSTOMER MASTER
// ═══════════════════════════════════════════════════════════

model Customer {
  id          Int      @id @default(autoincrement())
  
  // ── Core Identity ──
  name        String   @db.VarChar(200)  // Individual name OR Primary Contact Person
  phone       String   @db.VarChar(20)
  email       String?  @db.VarChar(100)
  cnic        String?  @db.VarChar(20)
  
  // ── Customer Type ──
  customerType String  @default("individual") // individual | corporate | university | ngo | government
  
  // ── Business/Organization Details (for B2B) ──
  businessName    String?  @db.VarChar(200)  // "Fast University", "UBL Bank", "Al-Khidmat NGO"
  businessType    String?  @db.VarChar(50)   // it_company | bank | university | ngo | hospital | govt_dept | other
  ntn             String?  @db.VarChar(50)    // National Tax Number (for GST invoice)
  strn            String?  @db.VarChar(50)    // Sales Tax Reg Number
  website         String?  @db.VarChar(100)
  
  // ── B2B Contact Person (jab customerType !== individual) ──
  contactPersonName        String?  @db.VarChar(200)
  contactPersonPhone       String?  @db.VarChar(20)
  contactPersonDesignation String?  @db.VarChar(100) // "HR Manager", "Admin Officer", "Event Coordinator"
  
  // ── Address ──
  address     String?
  city        String?  @db.VarChar(100)
  billingAddress String? @db.VarChar(300) // sometimes different from event location
  
  // ── Financial / B2B Terms ──
  creditLimit   Decimal?  @db.Decimal(12,2)  // Max credit allowed (e.g., 500,000)
  paymentTerms  String?   @default("immediate") @db.VarChar(20) // immediate | net15 | net30 | net60
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  
  // ── Meta ──
  referralSource String?  @db.VarChar(100) // "Facebook", "Reference from Ahmed", "Google"
  notes          String?

  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId    Int?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  bookings    Booking[]
  emergencyContacts CustomerEmergencyContact[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

model CustomerEmergencyContact {
