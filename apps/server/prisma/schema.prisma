// ── STAFF LEDGER (Running Account) ──
model StaffLedger {
  id              Int             @id @default(autoincrement())
  employeeId      Int
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type            StaffLedgerType
  amount          Decimal         @db.Decimal(12, 2)
  balance         Decimal         @db.Decimal(12, 2) // Running balance

  // ── Reference ──
  referenceType   String?         @db.VarChar(50) // Payroll, Event, Loan, Advance
  referenceId     Int?
  notes           String?
  bookingId       Int?

  // ── Multi-tenant + Audit ──
  companyId       Int
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        Int?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById     Int
  createdBy       User            @relation("StaffLedgerCreator", fields: [createdById], references: [id], onDelete: Cascade)
  date            DateTime        @default(now())

  createdAt       DateTime        @default(now())

  @@index([employeeId])
  @@index([companyId])
  @@index([branchId])
  @@index([date])
  @@index([type])
  @@map("staff_ledgers")
}

// ── STAFF PAYMENT (Direct payments to staff) ──
model StaffPayment {
  id              Int           @id @default(autoincrement())
  paymentNo       String        @db.VarChar(50)
  employeeId      Int
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)
  paymentType     StaffLedgerType

  // ── Links ──
  payrollItemId   Int?
  eventAssignmentId Int?

  // ── Payment Method ──
  method          PaymentMethod @default(cash)
  bankAccountId   Int?
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  reference       String?       // Cheque #, Txn ID
  notes           String?

  // ── Multi-tenant + Audit ──
  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        Int?
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById     Int
  createdBy       User            @relation("StaffPaymentCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([paymentNo, companyId])
  @@index([employeeId])
  @@index([companyId])
  @@index([branchId])
  @@index([bankAccountId])
  @@index([payrollItemId])
  @@map("staff_payments")
}



model Asset {
