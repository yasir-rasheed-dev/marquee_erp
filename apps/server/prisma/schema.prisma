// ═══════════════════════════════════════════════════════════
// COMPANY & BRANCH
// ═══════════════════════════════════════════════════════════

model Company {
  id        Int       @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  email     String?
  taxNumber String?
  logo      String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  branches            Branch[]
  users               User[]
  settings            CompanySettings?
  members             CompanyMember[]
  customers           Customer[]
  services            Service[]
  categories          Category[]
  items               Item[]
  menus               Menu[]
  menuItems           MenuItem[]
  inventory           InventoryItem[]
  packages            Package[]
  events              Event[]
  halls               Hall[]
  bookings            Booking[]
  invoices            Invoice[]
  auditLogs           AuditLog[]
  files               FileAttachment[]
  taxRates            TaxRate[]
  units               Unit[]
  assets              Asset[]
  assetTransactions   AssetTransaction[]
  recipeItems         RecipeItem[]
  wastageLogs         WastageLog[]
  productionPlans     ProductionPlan[]
  kitchenOrders       KitchenOrder[]
  stockTransfers      StockTransfer[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  purchaseBills     PurchaseBill[]
  purchaseReturns   PurchaseReturn[]
    supplierLedgers   SupplierLedger[]     // <-- ADD
  purchases         Purchase[]
  payments          Payment[]  
  bankAccounts BankAccount[]
  accountCustomCategories AccountCustomCategory[]
  accountTransactions AccountTransaction[]
    employees             Employee[]
  departments           Department[]
  designations          Designation[]
  payrolls              Payroll[]
  staffLedgers          StaffLedger[]
  staffPayments         StaffPayment[]
  eventStaffAssignments EventStaffAssignment[]
  attendances           Attendance[]
  leaves                Leave[]
  employeeLoans         EmployeeLoan[]
  rolePermissions     RolePermission[]
userRoleAssignments UserRoleAssignment[]
roles Role[]
receiptSettings ReceiptSetting[]
backupLogs          BackupLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("companies")
}

model CompanySettings {
  id              Int       @id @default(autoincrement())
  companyId       Int       @unique
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  timezone        String    @default("Asia/Karachi")
  dateFormat      String    @default("DD/MM/YYYY")
  timeFormat      String    @default("12h")
  currencyId      Int?
  currency        Currency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  fiscalYearStart String?
  invoicePrefix   String    @default("INV")
  bookingPrefix   String    @default("BKG")
  receiptPrefix   String    @default("RCP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

model Branch {
  id        Int       @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  companyId Int
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
receiptSettings ReceiptSetting[]
  users               User[]
  menus               Menu[]
  inventory           InventoryItem[]
  bookings            Booking[]
  invoices            Invoice[]
  packages            Package[]
  halls               Hall[]
  posSessions         POSSession[]
  categories          Category[]
  items               Item[]
  events              Event[]
  auditLogs           AuditLog[]
  tasks               Task[]
  stockTransactions   StockTransaction[]
  payments            Payment[]
  postransactions     POSTransaction[]
  whatsappMessages    WhatsAppMessage[]
  emailLogs           EmailLog[]
  settings            BranchSettings?
  menuItems           MenuItem[]
  units               Unit[]
  assets              Asset[]
  assetTransactions   AssetTransaction[]
  recipeItems         RecipeItem[]
  customers           Customer[]
  services            Service[]

  stockTransfersFrom  StockTransfer[] @relation("TransferFrom")
  stockTransfersTo    StockTransfer[] @relation("TransferTo")

  wastageLogs         WastageLog[]
  productionPlans     ProductionPlan[]
  kitchenOrders       KitchenOrder[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  purchaseBills     PurchaseBill[]
  purchaseReturns   PurchaseReturn[]
    supplierLedgers   SupplierLedger[]     // <-- ADD
  purchases         Purchase[]
  bankAccounts BankAccount[]
  accountCustomCategories AccountCustomCategory[]
  accountTransactions AccountTransaction[]
    employees             Employee[]
  departments           Department[]
  designations          Designation[]
  payrolls              Payroll[]
  staffLedgers          StaffLedger[]
  staffPayments         StaffPayment[]
  eventStaffAssignments EventStaffAssignment[]
  attendances           Attendance[]
  leaves                Leave[]
  employeeLoans         EmployeeLoan[]
  rolePermissions     RolePermission[]
userRoleAssignments UserRoleAssignment[]
roles Role[]
backupLogs    BackupLog[]
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([deletedAt])
  @@map("branches")
}

model BranchSettings {
  id               Int     @id @default(autoincrement())
  branchId         Int     @unique
  branch           Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  receiptFooter    String?
  receiptHeader    String?
  kitchenPrinterIp String?
  receiptPrinterIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branch_settings")
}
// ── Enums for Purchase & PO Workflow ──

enum POStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum BillStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

// ── Purchase Order (PO) - Sirf Order Place karne ke liye ──
model PurchaseOrder {
  id            Int             @id @default(autoincrement())
  poNo          String          @db.VarChar(50)
  supplierId    Int
  supplier      Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  status        POStatus        @default(ISSUED)
  orderDate     DateTime        @default(now())
  expectedDate  DateTime?
  
  subTotal      Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal         @default(0) @db.Decimal(12, 2)
  discount      Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal         @default(0) @db.Decimal(12, 2)
  
  notes         String?
companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      Int?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById   Int
  createdBy     User           @relation(fields: [createdById], references: [id])

  items         POItem[]
  purchaseBills PurchaseBill[]   // Ek PO se multiple bills

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([poNo, companyId])
  @@index([supplierId])
  @@index([companyId])
  @@map("purchase_orders")
}

model POItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  
  inventoryId     Int
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id])
  
  quantity        Decimal       @db.Decimal(12, 3)
  unitPrice       Decimal       @db.Decimal(12, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
  unit            String        @db.VarChar(20)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([inventoryId])
  @@map("po_items")
}

// ── Enums for Purchasing & Suppliers ──

enum SupplierType {
  LOCAL
  WHOLESALE
  IMPORTER
  FARMER_VENDOR
}

enum PurchaseStatus {
  PENDING
  SHIPPED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum PurchasePaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum ReturnStatus {
  PENDING
  COMPLETED
  REJECTED
}

// ── Supplier Master ──
model Supplier {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(200)
  code          String?        @db.VarChar(50)
  contactPerson String?        @db.VarChar(100)
  phone         String         @db.VarChar(20)
  email         String?        @db.VarChar(100)
  address       String?
  city          String?        @db.VarChar(100)
  type          SupplierType   @default(WHOLESALE)
  
  // Financial Tracking
  openingBalance Decimal       @default(0) @db.Decimal(12, 2)
  currentBalance Decimal       @default(0) @db.Decimal(12, 2) // + means we owe them, - means advance given
  
  isActive      Boolean        @default(true)
  deletedAt     DateTime?

  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId      Int?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)


  returns         PurchaseReturn[]
  purchases       Purchase[]
  purchaseOrders  PurchaseOrder[]
  purchaseBills   PurchaseBill[]
  payments        Payment[]
  supplierLedgers SupplierLedger[]


  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([code, companyId])
  @@index([companyId])
  @@index([branchId])
  @@index([phone])
  @@map("suppliers")
}

model SupplierLedger {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  type          String   // PO_CREATED, BILL_RECEIVED, PAYMENT_MADE, RETURN_ISSUED
  amount        Decimal  @db.Decimal(12, 2)
  balance       Decimal  @db.Decimal(12, 2)
  
  referenceId   Int?
  referenceType String?
  notes         String?
  
  branchId      Int?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())

  @@index([supplierId])
  @@index([date])
  @@map("supplier_ledgers")
}
model PurchaseBill {
  id              Int              @id @default(autoincrement())
  billNo          String           @db.VarChar(50)
  
  purchaseOrderId Int?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  
  supplierId      Int
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  status          BillStatus       @default(PENDING)
  paymentStatus   PurchasePaymentStatus @default(PENDING)
  
  dueDate         DateTime?
  
  subTotal        Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal          @default(0) @db.Decimal(12, 2)
  shippingCost    Decimal          @default(0) @db.Decimal(12, 2)
  loadingCost     Decimal          @default(0) @db.Decimal(12, 2)
  otherExpense    Decimal          @default(0) @db.Decimal(12, 2)
  discount        Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal          @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal          @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(12, 2)
  
  vehicleNo       String?          @db.VarChar(50)
  driverPhone     String?          @db.VarChar(20)
  notes           String?

  companyId       Int
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        Int?
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById     Int
  createdBy       User             @relation(fields: [createdById], references: [id])

  items           PurchaseBillItem[]
  payments        Payment[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([billNo, companyId])
  @@index([supplierId])
  @@index([companyId])
  @@index([branchId])
  @@map("purchase_bills")
}

model PurchaseBillItem {
  id              Int           @id @default(autoincrement())
  purchaseBillId  Int
  purchaseBill    PurchaseBill  @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)
  
  inventoryId     Int
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id])
  
  quantity        Decimal       @db.Decimal(12, 3)
  unitPrice       Decimal       @db.Decimal(12, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
  unit            String        @db.VarChar(20)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseBillId])
  @@index([inventoryId])
  @@map("purchase_bill_items")
}

// ── Purchase / Shipment Orders ──
model Purchase {
  id              Int                   @id @default(autoincrement())
  purchaseNo      String                @db.VarChar(50)
  supplierId      Int
  supplier        Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  status          PurchaseStatus        @default(PENDING) // PENDING, SHIPPED, RECEIVED, etc.
  paymentStatus   PurchasePaymentStatus @default(PENDING)
  
  orderDate       DateTime              @default(now())
  expectedDate    DateTime?
  receivedDate    DateTime?
  
  subTotal        Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal               @default(0) @db.Decimal(12, 2)
  discount        Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal               @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal               @default(0) @db.Decimal(12, 2)
  
  notes           String?
  vehicleNo       String?               @db.VarChar(50) // Shipment tracking ke liye
  driverPhone     String?               @db.VarChar(20)

  companyId       Int
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId        Int?
  branch          Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  createdById     Int
  createdBy       User                  @relation(fields: [createdById], references: [id])

  items           PurchaseItem[]
  payments        Payment[]             // Jo payments supplier ko ki jayengi
  returns         PurchaseReturn[]

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([purchaseNo, companyId])
  @@index([supplierId])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@map("purchases")
}

// ── Purchase Line Items ──
model PurchaseItem {
  id              Int           @id @default(autoincrement())
  purchaseId      Int
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  inventoryId     Int
  inventory       InventoryItem @relation(fields: [inventoryId], references: [id])
  
  orderedQty      Decimal       @db.Decimal(12, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(12, 3)
  unitPrice       Decimal       @db.Decimal(12, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
  
  unit            String        @db.VarChar(20)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseId])
  @@index([inventoryId])
  @@map("purchase_items")
}

// ── Purchase Return / Debit Note Flow ──
model PurchaseReturn {
  id          Int           @id @default(autoincrement())
  returnNo    String        @db.VarChar(50)
  purchaseId  Int?
  purchase    Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplierId  Int
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  status      ReturnStatus  @default(PENDING)
  totalAmount Decimal       @default(0) @db.Decimal(12, 2)
  reason      String?
  
  companyId   Int
  branchId    Int?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])
  
  items       PurchaseReturnItem[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([returnNo, companyId])
  @@index([supplierId])
  @@index([purchaseId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id          Int            @id @default(autoincrement())
  returnId    Int
  return      PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  inventoryId Int
  inventory   InventoryItem  @relation(fields: [inventoryId], references: [id])
  
  quantity    Decimal        @db.Decimal(12, 3)
  unitPrice   Decimal        @db.Decimal(12, 2)
  totalPrice  Decimal        @db.Decimal(12, 2)
  reason      String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([returnId])
  @@index([inventoryId])
  @@map("purchase_return_items")
}

// ═══════════════════════════════════════════════════════════
// CURRENCY & TAX
// ═══════════════════════════════════════════════════════════

model Currency {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(3)
  name     String
  symbol   String
  isActive Boolean @default(true)

  companySettings CompanySettings[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

model TaxRate {
  id       Int     @id @default(autoincrement())
  name     String
  rate     Decimal @db.Decimal(5, 2)
  isActive Boolean @default(true)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("tax_rates")
}

// ═══════════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════════

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  password  String
  role      String   @default("staff")
   
  phone     String?
  avatar    String?
  isActive  Boolean  @default(true)
  deletedAt DateTime?

  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdBookings     Booking[] @relation("BookingCreator")
  assignedBookings    Booking[] @relation("BookingAssignee")
  updatedBookings     Booking[] @relation("BookingUpdater")
  tasks               Task[]    @relation("TaskAssignee")
  payments            Payment[] @relation("PaymentUser")
  posSessions         POSSession[] @relation("POSSessionUser")
  stockTransactions   StockTransaction[] @relation("StockTransactionUser")
  auditLogs           AuditLog[] @relation("AuditLogUser")
  whatsappMessages    WhatsAppMessage[] @relation("WhatsAppMessageUser")
  emailLogs           EmailLog[] @relation("EmailLogUser")
  companyMembers      CompanyMember[] @relation("CompanyMemberUser")

  createdCategories   Category[] @relation("CategoryCreatedBy")
  updatedCategories   Category[] @relation("CategoryUpdatedBy")
  createdItems        Item[] @relation("ItemCreatedBy")
  updatedItems        Item[] @relation("ItemUpdatedBy")
  createdMenus        Menu[] @relation("MenuCreatedBy")
  updatedMenus        Menu[] @relation("MenuUpdatedBy")
  createdInventory    InventoryItem[] @relation("InventoryCreatedBy")
  updatedInventory    InventoryItem[] @relation("InventoryUpdatedBy")
  createdPackages     Package[] @relation("PackageCreatedBy")
  updatedPackages     Package[] @relation("PackageUpdatedBy")
  createdEvents       Event[] @relation("EventCreatedBy")
  updatedEvents       Event[] @relation("EventUpdatedBy")
  createdHalls        Hall[] @relation("HallCreatedBy")
  updatedHalls        Hall[] @relation("HallUpdatedBy")
  createdServices     Service[] @relation("ServiceCreatedBy")
  updatedServices     Service[] @relation("ServiceUpdatedBy")

  stockTransfers      StockTransfer[]
  wastageLogs         WastageLog[]
  userRoleAssignments UserRoleAssignment[]

  bookingChangeLogs       BookingChangeLog[]
  bookingMenuChangeLogs   BookingMenuChangeLog[]
  bookingServiceChangeLogs BookingServiceChangeLog[]
  eventDamages            EventDamage[]
  purchases         Purchase[]
  purchaseOrders    PurchaseOrder[]      // <-- ADD
  accountTransactions AccountTransaction[]
  purchaseBills   PurchaseBill[]
  purchaseReturns PurchaseReturn[]     // <-- ADD
    supplierLedgers SupplierLedger[]     // <-- ADD
      employee              Employee?
  staffLedgers          StaffLedger[]     @relation("StaffLedgerCreator")
  staffPayments         StaffPayment[]    @relation("StaffPaymentCreator")
  backupLogs          BackupLog[]
   googleDriveRefreshToken String? @db.Text
  googleDriveAccessToken  String? @db.Text
  googleDriveTokenExpiry  DateTime?
  googleDriveEmail        String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, companyId])
  @@index([email])
