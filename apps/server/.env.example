
DATABASE_URL=postgresql://postgres:password@localhost:5432/marquee_erp?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=marquee-super-secret-key-2026
JWT_REFRESH_SECRET=marquee-refresh-secret-key-2026
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Default Admin Credentials (Seed script)
DEFAULT_ADMIN_EMAIL=admin@marquee.com
DEFAULT_ADMIN_PASSWORD=admin123

# Database Backup Configuration
BACKUP_LOCAL_PATH=./backups
BACKUP_RETENTION_DAYS=30
PG_DUMP_PATH="C:\Program Files\PostgreSQL\18\bin\pg_dump.exe"


