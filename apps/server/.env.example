# ── Database (MySQL) ──
DATABASE_URL=mysql://root:@localhost:3306/marquee_erp
DATABASE_NAME=marquee_erp
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306
# Max MySQL connections this app opens (shared hosting caps max_user_connections)
DB_CONNECTION_LIMIT=5

# ── Server ──
PORT=5000
# Use "production" on the live server: enables rate limits, hides internal errors, enforces JWT secrets
NODE_ENV=development
# Allowed frontend origins, comma-separated (e.g. https://app.example.com,http://localhost:5175)
CLIENT_URL=http://localhost:5175
# Number of reverse proxies in front of Node (cPanel/Passenger = 1)
TRUST_PROXY=1

# ── Rate limits (per 15 minutes) ──
# API requests per logged-in user (anonymous: per IP)
RATE_LIMIT_MAX=1500
# Failed login/register attempts per IP
AUTH_RATE_LIMIT_MAX=10

# ── JWT Authentication ──
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# ── Default Admin Credentials (seed script) ──
DEFAULT_ADMIN_EMAIL=admin@marquee.com
DEFAULT_ADMIN_PASSWORD=change-me

# ── Database Backups (super admin only) ──
BACKUP_LOCAL_PATH=./backups
BACKUP_RETENTION_DAYS=30
# Windows/XAMPP example: C:\xampp\mysql\bin\mysqldump.exe — on Linux hosting leave empty (uses mysqldump from PATH)
MYSQLDUMP_PATH=
